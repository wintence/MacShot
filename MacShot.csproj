<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Global usings live in GlobalUsings.cs: the implicit version collides
         with System.Drawing because of NotifyIcon -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Needed solely for System.Windows.Forms.NotifyIcon -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Version>1.2.3</Version>
    <AssemblyName>MacShot</AssemblyName>
    <RootNamespace>MacShot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Application icon, embedded into the .exe: shown in Explorer,
         on the taskbar and in window title bars -->
    <ApplicationIcon>Resources\MacShotIconNew.ico</ApplicationIcon>

    <!-- WFAC010 asks to drop the DPI entries from the manifest and call
         Application.SetHighDpiMode instead. That advice targets WinForms
         applications. This is WPF: per-monitor DPI awareness comes from the
         manifest (PerMonitorV2), otherwise WPF scales the window itself and
         cursor coordinates stop matching client ones. WPF also offers no way
         to call SetHighDpiMode. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The application icon is needed twice: as ApplicationIcon above (for the
         .exe) and as an assembly resource (for window title bars). -->
    <Resource Include="Resources\MacShotIconNew.ico" />

    <!-- The tray icon is separate: in the tray it lives at 16-24 px, so its
         elements are thicker than in the application icon. -->
    <Resource Include="Resources\MacShotTray.ico" />
  </ItemGroup>

</Project>