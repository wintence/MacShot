<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Общие стили интерфейса.

         Раньше они жили в Window.Resources каждого окна, и одинаковые кнопки
         в трёх местах правились трижды. Словарь один — и анимации тоже.

         Правило, которому подчинены все переходы: двигается прозрачность
         или трансформация, но не цвет фона. Смена цвета элемента переводит
         его на программную отрисовку, и при большом числе кнопок окно
         начинает дёргаться. -->

    <!-- ================================================================
         Движение
         ================================================================ -->

    <!-- Основной переход: быстрый, без замедления в конце. -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <!-- Лёгкое превышение: кнопка слегка прогибается и возвращается. -->
    <BackEase x:Key="EasePress" EasingMode="EaseOut"/>

    <!-- ================================================================
         Текст
         ================================================================ -->

    <!-- Цвет текста здесь не задаём: надпись внутри кнопки должна брать
         Foreground самой кнопки (акцент у «Готово», красный у удаления),
         а сеттер неявного стиля перебил бы наследование и покрасил всё
         в один цвет. Базовый цвет задаёт окно. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ================================================================
         Кнопки
         ================================================================ -->

    <!-- Обычная кнопка.

         Три слоя: заливка, вуаль наведения, блик сверху. Наведение не
         меняет цвет фона, а проявляет вуаль — иначе каждый проход мыши
         вызывал бы полную перерисовку кнопки. -->
    <Style x:Key="Button" TargetType="Button">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="S" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Тень вынесена на отдельный слой под кнопкой.
                             Раньше DropShadowEffect висел на том же Border,
                             внутри которого лежит содержимое: эффект и
                             вложенный ScaleTransform вместе заставляли WPF
                             рисовать кнопку в промежуточную битмапу, и
                             нижняя кромка текста срезалась по базовой
                             линии. Раздельные слои это убирают. -->
                        <!-- Заливка -->
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True"/>

                        <!-- Вуаль наведения: полупрозрачный акцент поверх
                             всей заливки. Анимируется только прозрачность.
                             Слой лежит под рамкой, но не внутри отступов:
                             внутри них он красил только прямоугольник вокруг
                             надписи, и кнопка синела не вся. -->
                        <Border x:Name="Veil" Background="{DynamicResource AccentVeil}"
                                CornerRadius="8" Opacity="0"/>

                        <!-- Рамка и содержимое -->
                        <Border x:Name="B"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.2"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                    <!-- Уход курсора с нажатой кнопки: без этого
                                         она осталась бы уменьшенной. -->
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.16"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Нажатие: лёгкое сжатие. Отпускание возвращает
                             кнопку с небольшим перелётом, и движение
                             читается как физика, а не как переключатель. -->
                        <EventTrigger RoutedEvent="MouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="0.97" Duration="0:0:0.06"/>
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="0.97" Duration="0:0:0.06"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.22"
                                                     EasingFunction="{StaticResource EasePress}"/>
                                    <DoubleAnimation Storyboard.TargetName="S"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.22"
                                                     EasingFunction="{StaticResource EasePress}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Крестик удаления. Раньше это был глиф «✕» из шрифта: его
         чернильный прямоугольник не совпадает с полем строки, поэтому
         крестики в списке вставали на разной высоте. Две линии
         рисуются ровно по центру при любом размере кнопки. -->
    <Style x:Key="CloseButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Border x:Name="Veil" Background="{DynamicResource AccentVeil}"
                                        CornerRadius="7" Opacity="0"/>
                                <Path x:Name="Cross"
                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.2"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cross" Property="Stroke" Value="{DynamicResource Text}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кружки в заголовке окна. Системный заголовок перекрасить нельзя:
         на этой машине его перерисовывает Windhawk, и подсказка DWM
         пропадает. Поэтому заголовок свой, и кружки тоже свои. -->
    <!-- Кружки в заголовке окна. Порядок и цвета как на macOS: красный
         закрывает, жёлтый сворачивает, зелёный разворачивает. -->
    <Style x:Key="TrafficButton" TargetType="Button">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Dot" Width="12" Height="12"
                                 Fill="{TemplateBinding Foreground}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Dot" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="Foreground" Value="{DynamicResource DangerText}"/>
        <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
    </Style>

    <!-- Кнопка-ссылка: без заливки, только акцентный текст и вуаль под
         курсором. Так в macOS выглядит «Готово» — действие видно, но оно
         не спорит с содержимым окна. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Veil" CornerRadius="6"
                                Background="{DynamicResource AccentVeil}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.12"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Veil"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.2"
                                                     EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная кнопка диалога: заливка акцентом. Свечение и тень убраны:
         на акценте их не видно, а лишний слой эффекта стоит отрисовки. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================================================================
         Поле ввода
         ================================================================ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="0" VerticalAlignment="Center"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Ползунок
         ================================================================ -->

    <!-- Ползунок не меняет цвет и не имеет эффектов: анимируется только
         размер и свечение вокруг большого пальца. -->
    <!-- Бегунок ползунка: узкая вертикальная плашка, как в системных
         настройках. Ширина 14 — это поле захвата, сама плашка уже. -->
    <Style x:Key="Thumb" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="S" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border Width="6" Height="18" CornerRadius="3"
                                Background="{DynamicResource SliderKnob}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="S"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.5" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="S"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Части дорожки: слева от бегунка — акцент, справа — фон.
         По заливке видно значение, не читая подпись. -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="3" CornerRadius="1.5" Margin="0,0,-1,0"
                            Background="{DynamicResource Accent}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="3" CornerRadius="1.5" Margin="-1,0,0,0"
                            Background="{DynamicResource TrackBg}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <!-- Своя подсказка значения не нужна: число стоит в подписи над
             ползунком. Системная же рисуется светлым прямоугольником поверх
             тёмной карточки и выглядит белым пятном. -->
        <Setter Property="AutoToolTipPlacement" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRest}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Thumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Флажок
         ================================================================ -->

    <!-- Переключатель.

         Раньше это был квадрат с галочкой. В настройках каждая строка
         означает «включено или нет», и тумблер читается быстрее: положение
         видно по самому бегунку, а не по наличию штриха.

         Двигается только бегунок, трансформацией. Цвет дорожки меняется
         один раз, при щелчке, поэтому окно не уходит на программную
         отрисовку. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                        <Border x:Name="Track" Grid.Column="1"
                                Width="38" Height="22" CornerRadius="11"
                                Background="{DynamicResource ToggleOff}"
                                VerticalAlignment="Center">
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource ToggleKnob}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KX" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KX"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource EasePress}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KX"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Переключатель-радио
         ================================================================ -->

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RS" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="{DynamicResource Glow}" Opacity="0"
                                     Width="26" Height="26" RenderTransformOrigin="0.5,0.5"/>
                            <Ellipse x:Name="Ring" Fill="{DynamicResource Input}"
                                     Stroke="{DynamicResource ControlLine}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{DynamicResource Accent}" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DS" ScaleX="0.2" ScaleY="0.2"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Dot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="DS"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource EasePress}"/>
                                        <DoubleAnimation Storyboard.TargetName="DS"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource EasePress}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Dot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="DS"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.2" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="DS"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.2" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RS"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.12" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="RS"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.12" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RS"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="RS"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Подсказка
         ================================================================ -->

    <!-- Системная подсказка светлая в обеих темах и в тёмном окне светит
         белым пятном. Своя повторяет карточку: та же заливка, та же линия. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource CardLine}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="8,4">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Карточки настроек
         ================================================================ -->

    <!-- Карточка-группа. Без рамки: в тёмной теме карточка светлее фона,
         и одной заливки хватает, чтобы отделить её от страницы. -->
    <Style x:Key="CardBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="14,12,14,6"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Волосяная линия между строками карточки -->
    <Style x:Key="Hair" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="Background" Value="{DynamicResource CardLine}"/>
    </Style>

    <!-- ================================================================
         Боковая панель настроек
         ================================================================ -->

    <!-- Пункт списка разделов. Выбранный заливается акцентом целиком:
         так видно, на какой странице находишься, даже боковым зрением. -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Sel" CornerRadius="7"
                                Background="{DynamicResource Accent}" Opacity="0"/>
                        <Border x:Name="Hover" CornerRadius="7"
                                Background="{DynamicResource NavHover}" Opacity="0"/>
                        <ContentPresenter Margin="9,6" VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Sel" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Подпись пункта берёт цвет у самого пункта: при выборе он становится
         белым. Ссылка нужна потому, что неявный стиль текста задаёт цвет
         сам и перебил бы наследование. -->
    <Style x:Key="NavText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="9,0,0,0"/>
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>

    <!-- Строка результата поиска -->
    <Style x:Key="SearchRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="7"
                                Background="{DynamicResource NavHover}" Opacity="0"/>
                        <ContentPresenter Margin="9,6" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле поиска: рамки нет, подложка лежит отдельным слоем -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontFamily" Value="Segoe UI, system-ui"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка выбора темы: рамка вокруг миниатюры, выбранная — акцентная -->
    <Style x:Key="ThemeTile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" CornerRadius="9" BorderThickness="2"
                            BorderBrush="Transparent" Padding="2" Background="Transparent">
                        <ContentPresenter/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush"
                                    Value="{DynamicResource ControlLine}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush"
                                    Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Полоса прокрутки
         ================================================================ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" Background="{DynamicResource ScrollThumbBg}"
                            CornerRadius="4" Margin="3,0" Opacity="0.55"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="B"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="B"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Выпадающий список
         ================================================================ -->

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="F" Background="{DynamicResource Input}"
                                            BorderBrush="{DynamicResource CardLine}" BorderThickness="1"
                                            CornerRadius="8"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="F" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Site" Margin="11,7" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>

                        <Path x:Name="Arrow" HorizontalAlignment="Right" Margin="0,0,11,0"
                              Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}"
                              StrokeThickness="1.4" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="AR" Angle="0" CenterX="4" CenterY="2"/>
                            </Path.RenderTransform>
                        </Path>

                        <!-- Список выезжает сверху вниз и проявляется.
                             Одного Fade было мало: список появлялся
                             мгновенно и выглядел вставленным. -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                            <Border x:Name="Drop" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource CardLine}"
                                    BorderThickness="1" CornerRadius="10"
                                    Margin="0,6,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="260" RenderTransformOrigin="0.5,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="DropLift" Y="-8"/>
                                </Border.RenderTransform>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Drop"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DropLift"
                                                         Storyboard.TargetProperty="Y"
                                                         From="-8" To="0" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="AR"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="180" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Drop"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="DropLift"
                                                         Storyboard.TargetProperty="Y"
                                                         From="0" To="-8" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="AR"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="B" Background="Transparent" CornerRadius="6"
                            Margin="3,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Появление окна
         ================================================================ -->

    <!-- Готовая анимация появления. Код вызывает её на элементе и задаёт
         задержку, чтобы секции въезжали по очереди, а не разом. -->
    <Storyboard x:Key="Appear">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.28"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="14" To="0" Duration="0:0:0.42"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

</ResourceDictionary>