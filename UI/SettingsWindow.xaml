<Window x:Class="MacShot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacShot.Lang"
        Width="1160" Height="820"
        MinWidth="940" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#17171B"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, system-ui">

    <Window.Resources>

        <!-- ============ Палитра ============ -->
        <SolidColorBrush x:Key="Bg"        Color="#17171B"/>
        <SolidColorBrush x:Key="Card"      Color="#212128"/>
        <SolidColorBrush x:Key="CardLine"  Color="#2E2E38"/>
        <SolidColorBrush x:Key="Input"     Color="#1A1A20"/>
        <SolidColorBrush x:Key="Text"      Color="#E9E9EF"/>
        <SolidColorBrush x:Key="Muted"     Color="#8E8E99"/>
        <SolidColorBrush x:Key="Accent"    Color="#4C8DFF"/>
        <SolidColorBrush x:Key="AccentDim" Color="#2F4E86"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Input}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11,7"/>
        </Style>

        <!-- ============ Кнопка ============ -->
        <!-- Собственный шаблон вместо системного: стандартный в Windows
             выглядит как серый прямоугольник и выбивается из тёмной темы.
             Фон с лёгким градиентом даёт кнопке объём, а не плоскую заливку. -->
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#2E2E3A"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#3A3A48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <!-- Тонкая светлая линия сверху: кнопка читается
                                 как приподнятая, даже в тёмной теме -->
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                  Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Тонкая светлая линия сверху: кнопка читается
                                     как приподнятая, даже в тёмной теме -->
                                <Border Background="#14FFFFFF" CornerRadius="8"
                                        Height="1" VerticalAlignment="Top"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3B3B4A"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#4A4A5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#24242E"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-иконка: квадратная, без подписи. Для крестиков в списке. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#26262F"/>
            <Setter Property="BorderBrush" Value="#33333E"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Foreground" Value="#FF8A8A"/>
            <Setter Property="Background" Value="#33242B"/>
            <Setter Property="BorderBrush" Value="#4A2E36"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="#4C8DFF"/>
            <Setter Property="Foreground" Value="#08111F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#4C8DFF"/>
            <Setter Property="Padding" Value="26,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                  Opacity="0.45" Color="#1B4F9E"/>
                            </Border.Effect>
                            <Grid>
                                <Border Background="#33FFFFFF" CornerRadius="8"
                                        Height="1" VerticalAlignment="Top"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#6BA1FF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#6BA1FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3D7BEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Поле ввода ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Ползунок ============ -->
        <Style x:Key="Thumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource Text}" CornerRadius="8"
                                BorderBrush="#0A0A0D" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#2C2C36"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Переключатель ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{StaticResource Input}"
                                    BorderBrush="#3C3C4A" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,9 L 7,13 L 15,4"
                                      Stroke="#0B1220" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Переключатель-радио ============ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="{StaticResource Input}"
                                         Stroke="#3C3C4A" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Полоса прокрутки ============ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A4A58" CornerRadius="4" Margin="3,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Preview" TargetType="Border">
            <Setter Property="Height" Value="72"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ============ Выпадающий список ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Input}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Input}"
                                                BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                                CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Site" Margin="11,7" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"/>
                            <Path x:Name="Arrow" HorizontalAlignment="Right" Margin="0,0,11,0"
                                  Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.4" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#26262F" BorderBrush="{StaticResource CardLine}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Квадрат позиции на рамке кадра ============ -->
        <Style x:Key="Spot" TargetType="RadioButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="#26262F" CornerRadius="4"
                                BorderBrush="#3C3C4A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <!-- Левая колонка: предпросмотр сверху и под ним водяные знаки.
         Предпросмотр прижат к верху и не уезжает при прокрутке — иначе
         пришлось бы запоминать, куда только что потянули знак.
         Правая колонка — остальные настройки, прокручивается вся. -->
    <Grid x:Name="RootGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Левая колонка ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                    MaxHeight="430" VerticalAlignment="Top">
                <Border x:Name="WatermarkPreview"/>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{x:Static local:L.Watermark}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                    <!-- Список добавленных надписей и картинок -->
                    <StackPanel x:Name="MarkList" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static local:L.AddText}" Click="OnAddTextMark"
                                Style="{StaticResource Button}"/>
                        <Button Content="{x:Static local:L.AddPicture}" Click="OnAddPictureMark"
                                Style="{StaticResource Button}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Редактор выбранного элемента -->
                    <StackPanel x:Name="MarkEditor" Margin="0,18,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource CardLine}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="MarkKindLabel" Style="{StaticResource Caption}"/>

                        <!-- Содержимое: у надписи — текст, у картинки — файл -->
                        <Border x:Name="MarkTextField" Style="{StaticResource Field}">
                            <TextBox x:Name="MarkContentBox" TextChanged="OnMarkChanged"
                                     LostFocus="OnMarkCommitted" FontFamily="Segoe UI, system-ui"/>
                        </Border>

                        <StackPanel x:Name="MarkPicturePanel" Visibility="Collapsed">
                            <TextBlock x:Name="MarkPathLabel" Text="{x:Static local:L.NoFile}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <Button Content="{x:Static local:L.PickPicture}" Click="OnPickMarkPicture"
                                    Style="{StaticResource Button}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Шрифт надписи. Выбор позиции живёт прямо на
                             предпросмотре: квадраты стоят на рамке кадра,
                             и клик по нему переносит знак. -->
                        <StackPanel x:Name="MarkFontPanel" Margin="0,14,0,0">
                            <TextBlock Text="{x:Static local:L.Font}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FontBox" SelectionChanged="OnMarkChanged"/>
                        </StackPanel>
                        <!-- Цвет надписи -->
                        <Grid x:Name="MarkColorRow" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Field}">
                                <TextBox x:Name="MarkColorBox" Text="#FFFFFF"
                                         TextChanged="OnMarkColorChanged" LostFocus="OnMarkCommitted"/>
                            </Border>
                            <Border Grid.Column="2" x:Name="MarkColorSwatch"
                                    Width="40" Height="36" CornerRadius="8"
                                    Background="#FFFFFF" Cursor="Hand"
                                    BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                    ToolTip="{x:Static local:L.PaletteTip}"
                                    MouseLeftButtonUp="OnPickMarkColor"/>
                        </Grid>

                        <TextBlock x:Name="MarkSizeLabel" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                        <Slider x:Name="MarkSizeSlider" Minimum="6" Maximum="200" Value="18"
                                ValueChanged="OnMarkChanged"/>

                        <TextBlock x:Name="MarkOpacityLabel" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                        <Slider x:Name="MarkOpacitySlider" Minimum="0" Maximum="100" Value="90"
                                ValueChanged="OnMarkChanged"/>

                        <TextBlock x:Name="MarkMarginLabel" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                        <Slider x:Name="MarkMarginSlider" Minimum="0" Maximum="160" Value="24"
                                ValueChanged="OnMarkChanged"/>

                        <StackPanel x:Name="MarkStylePanel">
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox x:Name="BoldCheck" Content="{x:Static local:L.Bold}"
                                          Checked="OnMarkChanged" Unchecked="OnMarkChanged" Cursor="Hand"/>
                                <CheckBox x:Name="ItalicCheck" Content="{x:Static local:L.Italic}"
                                          Checked="OnMarkChanged" Unchecked="OnMarkChanged"
                                          Cursor="Hand" Margin="18,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="MarkShadowCheck" Content="{x:Static local:L.MarkShadow}"
                                      Checked="OnMarkChanged" Unchecked="OnMarkChanged"
                                      Cursor="Hand" Margin="0,14,0,0"/>

                            <StackPanel x:Name="MarkShadowPanel" Margin="28,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Field}">
                                        <TextBox x:Name="ShadowColorBox" Text="#000000"
                                                 TextChanged="OnMarkColorChanged" LostFocus="OnMarkCommitted"/>
                                    </Border>
                                    <Border Grid.Column="2" x:Name="ShadowColorSwatch"
                                            Width="40" Height="36" CornerRadius="8"
                                            Background="#000000" Cursor="Hand"
                                            BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                            ToolTip="{x:Static local:L.PaletteTip}"
                                            MouseLeftButtonUp="OnPickShadowColor"/>
                                </Grid>

                                <TextBlock x:Name="ShadowBlurLabel" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                                <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="40" Value="6"
                                        ValueChanged="OnMarkChanged"/>

                                <TextBlock x:Name="ShadowOpacityLabel" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                                <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="100" Value="50"
                                        ValueChanged="OnMarkChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="{x:Static local:L.BtnRemove}" Click="OnRemoveMark"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                Margin="0,20,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="MarkEmptyHint" Text="{x:Static local:L.MarkEmpty}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Правая колонка ============ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ============ Фон ============ -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.Bg}" Style="{StaticResource Caption}"/>

                        <RadioButton x:Name="BgSolid" Content="{x:Static local:L.BgSolid}" Tag="Solid"
                                     Checked="OnBackgroundChanged" Cursor="Hand"/>
                        <RadioButton x:Name="BgGradient" Content="{x:Static local:L.BgGradient}" Tag="Gradient"
                                     Checked="OnBackgroundChanged" Cursor="Hand"/>
                        <RadioButton x:Name="BgImage" Content="{x:Static local:L.BgImage}" Tag="Image"
                                     Checked="OnBackgroundChanged" Cursor="Hand" Margin="0"/>

                        <StackPanel x:Name="SolidPanel" Margin="0,14,0,0">
                            <TextBlock Text="{x:Static local:L.Color}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Field}">
                                    <TextBox x:Name="SolidColorBox" Text="#E9EDF5"
                                             TextChanged="OnColorTextChanged" LostFocus="OnColorCommitted"/>
                                </Border>
                                <Border Grid.Column="2" x:Name="SolidSwatch"
                                        Width="40" Height="36" CornerRadius="8"
                                        Background="#E9EDF5" Cursor="Hand"
                                        BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                        ToolTip="{x:Static local:L.PaletteTip}"
                                        MouseLeftButtonUp="OnPickSolid"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="GradientPanel" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static local:L.Start}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Field}">
                                            <TextBox x:Name="GradientStartBox" Text="#E9EDF5"
                                                     TextChanged="OnColorTextChanged" LostFocus="OnColorCommitted"/>
                                        </Border>
                                        <Border Grid.Column="2" x:Name="GradientStartSwatch"
                                                Width="40" Height="36" CornerRadius="8"
                                                Background="#E9EDF5" Cursor="Hand"
                                                BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                                ToolTip="{x:Static local:L.PaletteTip}"
                                                MouseLeftButtonUp="OnPickGradientStart"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static local:L.End}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Field}">
                                            <TextBox x:Name="GradientEndBox" Text="#C3CDE0"
                                                     TextChanged="OnColorTextChanged" LostFocus="OnColorCommitted"/>
                                        </Border>
                                        <Border Grid.Column="2" x:Name="GradientEndSwatch"
                                                Width="40" Height="36" CornerRadius="8"
                                                Background="#C3CDE0" Cursor="Hand"
                                                BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                                ToolTip="{x:Static local:L.PaletteTip}"
                                                MouseLeftButtonUp="OnPickGradientEnd"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="AngleLabel" Text="{x:Static local:L.Start}"
                                       Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                            <Slider x:Name="AngleSlider" Minimum="0" Maximum="360" Value="90"
                                    ValueChanged="OnAngleChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="ImagePanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ImagePathLabel" Text="{x:Static local:L.NoFile}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <Button Content="{x:Static local:L.PickImage}" Click="OnPickBackgroundImage"
                                    Style="{StaticResource Button}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border x:Name="BackgroundPreview" Style="{StaticResource Preview}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ Окно ============ -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.Window}" Style="{StaticResource Caption}"/>

                        <TextBlock x:Name="PaddingLabel" Text="{x:Static local:L.Start}"
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <Slider x:Name="PaddingSlider" Minimum="0" Maximum="160" Value="40"
                                ValueChanged="OnValueChanged"/>

                        <CheckBox x:Name="ShadowCheck" Content="{x:Static local:L.Shadow}" IsChecked="True"
                                  Checked="OnShadowChanged" Unchecked="OnShadowChanged"
                                  Cursor="Hand" Margin="0,16,0,0"/>

                        <TextBlock x:Name="BlurLabel" Text="{x:Static local:L.Start}"
                                   Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Slider x:Name="BlurSlider" Minimum="0" Maximum="90" Value="36"
                                ValueChanged="OnValueChanged"/>

                        <TextBlock x:Name="OpacityLabel" Text="{x:Static local:L.Start}"
                                   Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="45"
                                ValueChanged="OnValueChanged"/>

                        <TextBlock x:Name="OffsetLabel" Text="{x:Static local:L.Start}"
                                   Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Slider x:Name="OffsetSlider" Minimum="0" Maximum="60" Value="16"
                                ValueChanged="OnValueChanged"/>

                        <CheckBox x:Name="HideTitleCheck" Content="{x:Static local:L.HideTitleBar}"
                                  IsChecked="False" Checked="OnTitleBarChanged"
                                  Unchecked="OnTitleBarChanged" Cursor="Hand" Margin="0,18,0,0"/>

                        <TextBlock x:Name="TitleBarLabel" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <Slider x:Name="TitleBarSlider" Minimum="0" Maximum="120" Value="32"
                                ValueChanged="OnTitleBarChanged"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{x:Static local:L.HideTitleBarHint}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Горячая клавиша ============ -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.HotKey}" Style="{StaticResource Caption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Field}" Padding="13,10">
                                <TextBlock x:Name="HotKeyLabel" Text="Ctrl+Shift+8" FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="1" Content="{x:Static local:L.SetHotKey}" Click="OnSetHotKey"
                                    Style="{StaticResource Button}" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="HotKeyStatus" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ============ Сохранение и запуск ============ -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.Storage}" Style="{StaticResource Caption}"/>

                        <CheckBox x:Name="SaveCheck" Content="{x:Static local:L.SaveCopy}"
                                  Checked="OnFlagChanged" Unchecked="OnFlagChanged" Cursor="Hand"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,14" TextWrapping="Wrap"
                                   Text="{x:Static local:L.SaveHint}"/>

                        <CheckBox x:Name="StartupCheck" Content="{x:Static local:L.Startup}"
                                  Checked="OnFlagChanged" Unchecked="OnFlagChanged" Cursor="Hand"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0" TextWrapping="Wrap"
                                   Text="{x:Static local:L.StartupHint}"/>
                    </StackPanel>
                </Border>

                <!-- Язык — в самом низу: он меняется редко, а место в начале
                     колонки занимают настройки, которые правят каждый раз -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.Language}" x:Name="LangCaption"
                                   Style="{StaticResource Caption}" Tag="lang"/>
                        <RadioButton x:Name="LangRu" GroupName="Lang"
                                     Content="{x:Static local:L.LanguageRu}"
                                     Checked="OnLanguageChanged" Cursor="Hand"/>
                        <RadioButton x:Name="LangEn" GroupName="Lang" Margin="0"
                                     Content="{x:Static local:L.LanguageEn}"
                                     Checked="OnLanguageChanged" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Подвал: версия и ссылка на исходники. Внизу, потому что
                     смотреть в него приходится редко, а место в начале
                     колонки дороже -->
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:L.AppTitle}" Style="{StaticResource Caption}"/>
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/wintence/MacShot"
                                       RequestNavigate="OnOpenLink">
                                <TextBlock Text="{x:Static local:L.Repository}"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="12" TextDecorations="Underline"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                    <Button x:Name="CloseButton" Content="{x:Static local:L.BtnDone}" Click="OnCloseClick"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
